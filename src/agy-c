#!/bin/bash
set -e
IMAGE_NAME="agy-box"
ALLOWED_DIR="^$HOME/[^./]"

PROMPT="[Y/n]"
DEFAULT="Y"

if [[ ! "$PWD" =~ $ALLOWED_DIR ]]; then
    echo "ВНИМАНИЕ: запуск Antigravity в $PWD небезопасен"
    PROMPT="[y/N]"
    DEFAULT="N"
fi

read -r -p "Запустить Antigravity в $PWD? $PROMPT " answer
case "${answer:-$DEFAULT}" in
    [Nn]*)
        echo "Запуск отменен"
        exit 1
        ;;
    [Yy]*)
        echo "[*] Запуск Antigravity"
        ;;
    *)
        echo "Нераспознанный ввод, запуск отменен"
        exit 1
        ;;
esac

exec podman run --rm -it \
    --memory=8g --cpus=4 --pids-limit=500 \
    -v agy-gemini-data:/root/.gemini:Z \
    -v agy-config-data:/root/.config/antigravity:Z \
    -v "${PWD}:/workspace:Z" \
    -w /workspace \
    "${IMAGE_NAME}" "$@"